import csv
import itertools
import os
import re
import sys

# Anchor the run to the workflow directory so `snakemake -s /path/to/Snakefile`
# behaves identically from any cwd, while every path below stays relative --
# which is what makes `snakemake results/stats/X.seqkit` work as a target.
WORKFLOW_DIR = os.path.dirname(os.path.abspath(workflow.snakefile))

workdir: WORKFLOW_DIR

configfile: os.path.join(WORKFLOW_DIR, "config.yaml")


def die(msg):
    """Abort at parse time with an actionable message instead of a traceback."""
    raise WorkflowError("\n".join(["", "=" * 72, msg.rstrip(), "=" * 72]))


def require_config(*keys):
    node, seen = config, []
    for k in keys:
        seen.append(k)
        if not isinstance(node, dict) or k not in node:
            die(f"config.yaml is missing the required key: {'.'.join(seen)}")
        node = node[k]
    return node


for _required in (("aligner",), ("paths", "data_dir"), ("paths", "output_dir"),
                  ("paths", "genome"), ("metadata",), ("python_bin",),
                  ("deseq2", "padj"), ("deseq2", "log2fc"), ("deseq2", "min_counts")):
    require_config(*_required)

ALIGNER = config["aligner"]
LAYOUT  = config.get("layout", "paired")   # "paired" or "single"

# paths — all sourced from config.yaml, all relative to WORKFLOW_DIR (see workdir:)
data_dir     = config["paths"]["data_dir"]
out          = config["paths"]["output_dir"]
genome_fasta = config["paths"]["genome"]
genome_dir   = genome_fasta                      # kept: used as the bwa index prefix
annotation_gtf    = config["paths"].get("annotation", "")
splice_sites_file = config["paths"].get("splice_sites", "")
USE_GTF           = bool(annotation_gtf) and os.path.isfile(annotation_gtf)

metadata_file = config["metadata"]
scripts_dir   = "scripts"
python_bin    = config["python_bin"]

synced_dir   = os.path.join(out, "raw_data_synced")
fastqc_dir   = os.path.join(out, "fastqc_reports")
mapped_dir   = os.path.join(out, "processed_bams")
stats_dir    = os.path.join(out, "stats")
coverage_dir = os.path.join(out, "coverage")
counts_dir   = os.path.join(out, "counts")
deseq2_dir   = os.path.join(out, "deseq2")

ht2_index_prefix = os.path.join(out, "index_genome_ht2", "genome")
bt2_index_prefix = os.path.join(out, "index_genome_bt2", "genome")

# sample detection
if LAYOUT not in ("paired", "single"):
    die(f"Unknown layout '{LAYOUT}' in config.yaml. Choose: paired, single")

if not os.path.isdir(data_dir):
    die(
        f"FASTQ directory not found: {os.path.abspath(data_dir)}\n"
        f"  (config.yaml paths.data_dir = {data_dir!r}, resolved against {WORKFLOW_DIR})\n"
        f"Create it and put your reads there, or point paths.data_dir at the right place."
    )

if LAYOUT == "paired":
    SAMPLES = sorted({
        fn.split("_")[0]
        for fn in os.listdir(data_dir)
        if fn.endswith("_1.fastq.gz") or fn.endswith("_2.fastq.gz")
    })
else:
    SAMPLES = sorted({
        fn[:-len(".fastq.gz")]
        for fn in os.listdir(data_dir)
        if fn.endswith(".fastq.gz")
        and not fn.endswith("_1.fastq.gz")
        and not fn.endswith("_2.fastq.gz")
    })

if not SAMPLES:
    expected = "{sample}_1.fastq.gz / {sample}_2.fastq.gz" if LAYOUT == "paired" else "{sample}.fastq.gz"
    die(
        f"No {LAYOUT}-end FASTQ files found in {data_dir}\n"
        f"Expected filenames of the form: {expected}\n"
        f"Directory contains: {sorted(os.listdir(data_dir))[:10] or '(empty)'}"
    )

if LAYOUT == "paired":
    _incomplete = [
        s for s in SAMPLES
        if not (os.path.exists(os.path.join(data_dir, f"{s}_1.fastq.gz"))
                and os.path.exists(os.path.join(data_dir, f"{s}_2.fastq.gz")))
    ]
    if _incomplete:
        die(
            "These samples are missing one mate of the pair:\n  "
            + "\n  ".join(_incomplete)
            + "\nEvery paired-end sample needs both _1.fastq.gz and _2.fastq.gz."
        )

# Without this, {sample} matches greedily and Snakemake can derive
# "{sample}.sorted.bam" from sam_to_bam with sample="X.sorted" -- an endless
# .sorted.sorted... chain that turns every real error into a nonsensical one.
wildcard_constraints:
    sample = "|".join(re.escape(s) for s in SAMPLES)

# --- conditions and pairwise comparisons, mirrored from scripts/deseq2.py ----
if not os.path.isfile(metadata_file):
    die(
        f"Metadata file not found: {os.path.abspath(metadata_file)}\n"
        f"  (config.yaml metadata = {config['metadata']!r})\n"
        f"It must be a CSV with columns: sample,condition"
    )

with open(metadata_file, newline="") as _fh:
    _reader = csv.DictReader(_fh)
    if not _reader.fieldnames or "sample" not in _reader.fieldnames or "condition" not in _reader.fieldnames:
        die(f"{metadata_file} must have 'sample' and 'condition' columns; got {_reader.fieldnames}")
    METADATA = {r["sample"].strip(): r["condition"].strip() for r in _reader if r.get("sample")}

_unknown = sorted(set(SAMPLES) - set(METADATA))
if _unknown:
    die(
        "These FASTQ samples are not listed in the metadata file:\n  "
        + "\n  ".join(_unknown)
        + f"\nAdd them to {metadata_file}, or remove their FASTQs from {data_dir}."
    )

CONDITIONS = sorted({METADATA[s] for s in SAMPLES})
if len(CONDITIONS) < 2:
    die(
        f"DESeq2 needs at least two conditions; the metadata gives only {CONDITIONS}."
    )
# deseq2.py iterates itertools.combinations(sorted(conditions), 2) -- keep in sync.
PAIRS = [f"{a}vs{b}" for a, b in itertools.combinations(CONDITIONS, 2)]

# merge_counts and deseq2 run through this interpreter; a bad path here used to
# surface only after every alignment had finished.
if "/" in config["python_bin"] and not os.path.isfile(python_bin):
    die(
        f"python_bin does not exist: {os.path.abspath(python_bin)}\n"
        f"  (config.yaml python_bin = {config['python_bin']!r})\n"
        f"Rules merge_counts and deseq2 need it, with pandas / numpy / matplotlib / pydeseq2 installed.\n"
        f"Create it with:\n"
        f"    python3 -m venv {os.path.join(WORKFLOW_DIR, '.venv')}\n"
        f"    {os.path.join(WORKFLOW_DIR, '.venv/bin/pip')} install pandas numpy matplotlib pydeseq2\n"
        f"or set python_bin to an interpreter that already has them."
    )

# aligner index configuration
if ALIGNER == "hisat2":
    INDEX_FILES  = expand(ht2_index_prefix + ".{ext}",
                          ext=["1.ht2","2.ht2","3.ht2","4.ht2","5.ht2","6.ht2","7.ht2","8.ht2"])
    INDEX_PREFIX = ht2_index_prefix
elif ALIGNER == "bowtie2":
    INDEX_FILES  = expand(bt2_index_prefix + ".{ext}",
                          ext=["1.bt2","2.bt2","3.bt2","4.bt2","rev.1.bt2","rev.2.bt2"])
    INDEX_PREFIX = bt2_index_prefix
elif ALIGNER == "bwa":
    INDEX_FILES  = [genome_dir + ext for ext in [".amb", ".ann", ".bwt", ".pac", ".sa"]]
    INDEX_PREFIX = genome_dir
else:
    raise ValueError(f"Unknown aligner '{ALIGNER}'. Choose: hisat2, bowtie2, bwa")

# main
rule all:
    input:
        expand(f"{fastqc_dir}/{{sample}}_1_fastqc.html", sample=SAMPLES) if LAYOUT == "paired" else [],
        expand(f"{fastqc_dir}/{{sample}}_1_fastqc.zip",  sample=SAMPLES) if LAYOUT == "paired" else [],
        expand(f"{fastqc_dir}/{{sample}}_2_fastqc.html", sample=SAMPLES) if LAYOUT == "paired" else [],
        expand(f"{fastqc_dir}/{{sample}}_2_fastqc.zip",  sample=SAMPLES) if LAYOUT == "paired" else [],
        expand(f"{fastqc_dir}/{{sample}}_fastqc.html",   sample=SAMPLES) if LAYOUT == "single" else [],
        expand(f"{fastqc_dir}/{{sample}}_fastqc.zip",    sample=SAMPLES) if LAYOUT == "single" else [],
        expand(f"{coverage_dir}/{{sample}}.coverage",    sample=SAMPLES),
        expand(f"{stats_dir}/{{sample}}.seqkit",         sample=SAMPLES),
        expand(f"{stats_dir}/{{sample}}.flagstat",       sample=SAMPLES),
        f"{fastqc_dir}/multiqc_report.html",
        f"{counts_dir}/count_table.txt",
        expand(f"{deseq2_dir}/{{pair}}_intersect.txt", pair=PAIRS),
        f"{deseq2_dir}/PCA_plot.pdf"

# ── paired-end only rules ────────────────────────────────────────────────────

if LAYOUT == "paired":

    rule check_pairs:
        input:
            read_1 = f"{data_dir}/{{sample}}_1.fastq.gz",
            read_2 = f"{data_dir}/{{sample}}_2.fastq.gz"
        output:
            seqkit_output = f"{stats_dir}/{{sample}}.seqkit"
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/seqkit-2.5.1
            THREADS=${{NSLOTS:-$(nproc)}}
            seqkit stats -j $THREADS -T {input.read_1} {input.read_2} > {output.seqkit_output}
            # seqkit exits 0 even when a FASTQ is unreadable, leaving a
            # header-only table that repair_files would read as "counts match".
            rows=$(tail -n +2 {output.seqkit_output} | grep -c . || true)
            if [ "$rows" -ne 2 ]; then
                echo "ERROR: seqkit produced $rows data rows for {wildcards.sample}, expected 2." >&2
                echo "One of the FASTQ files is unreadable or not valid FASTQ:" >&2
                echo "  {input.read_1}" >&2
                echo "  {input.read_2}" >&2
                exit 1
            fi
            '''

    rule repair_files:
        input:
            read_1        = f"{data_dir}/{{sample}}_1.fastq.gz",
            read_2        = f"{data_dir}/{{sample}}_2.fastq.gz",
            seqkit_output = f"{stats_dir}/{{sample}}.seqkit"
        output:
            read_1     = f"{synced_dir}/{{sample}}_1.fastq.gz",
            read_2     = f"{synced_dir}/{{sample}}_2.fastq.gz",
            singletons = f"{synced_dir}/{{sample}}_singletons.fastq.gz"
        log:
            f"{stats_dir}/{{sample}}.sync_pairs.log"
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/bbmap-38.84

            r1c=$(awk 'NR==2{{print $4}}' {input.seqkit_output})
            r2c=$(awk 'NR==3{{print $4}}' {input.seqkit_output})

            case "$r1c$r2c" in
                *[!0-9]*|"") echo "ERROR: unusable read counts in {input.seqkit_output} (r1='$r1c' r2='$r2c')" >&2; exit 1 ;;
            esac

            if [ "$r1c" != "$r2c" ]; then
                echo "[sync] {wildcards.sample}: MISMATCH ($r1c vs $r2c) → repair.sh" &>> {log}
                repair.sh \
                  in1={input.read_1} in2={input.read_2} \
                  out1={output.read_1} out2={output.read_2} \
                  outs={output.singletons} overwrite=t &>> {log}
            else
                echo "[sync] {wildcards.sample}: OK ($r1c==$r2c) → symlinks" &>> {log}
                ln -sf $(realpath {input.read_1}) {output.read_1}
                ln -sf $(realpath {input.read_2}) {output.read_2}
                gzip -c </dev/null > {output.singletons}
            fi
            '''

    rule fastqc:
        input:
            read_1 = f"{data_dir}/{{sample}}_1.fastq.gz",
            read_2 = f"{data_dir}/{{sample}}_2.fastq.gz"
        output:
            read_1_html = f"{fastqc_dir}/{{sample}}_1_fastqc.html",
            read_1_zip  = f"{fastqc_dir}/{{sample}}_1_fastqc.zip",
            read_2_html = f"{fastqc_dir}/{{sample}}_2_fastqc.html",
            read_2_zip  = f"{fastqc_dir}/{{sample}}_2_fastqc.zip"
        params:
            outdir = fastqc_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/fastqc-0.12.1
            fastqc {input.read_1} {input.read_2} --outdir {params.outdir}
            '''

    rule multiqc:
        input:
            expand(f"{fastqc_dir}/{{sample}}_1_fastqc.zip", sample=SAMPLES),
            expand(f"{fastqc_dir}/{{sample}}_2_fastqc.zip", sample=SAMPLES)
        output:
            f"{fastqc_dir}/multiqc_report.html"
        params:
            outdir = fastqc_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/multiqc-1.23
            multiqc {params.outdir} -o {params.outdir}
            '''

# ── single-end only rules ────────────────────────────────────────────────────

elif LAYOUT == "single":

    rule check_reads:
        input:
            read = f"{data_dir}/{{sample}}.fastq.gz"
        output:
            seqkit_output = f"{stats_dir}/{{sample}}.seqkit"
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/seqkit-2.5.1
            THREADS=${{NSLOTS:-$(nproc)}}
            seqkit stats -j $THREADS -T {input.read} > {output.seqkit_output}
            rows=$(tail -n +2 {output.seqkit_output} | grep -c . || true)
            if [ "$rows" -ne 1 ]; then
                echo "ERROR: seqkit produced $rows data rows for {wildcards.sample}, expected 1." >&2
                echo "{input.read} is unreadable or not valid FASTQ." >&2
                exit 1
            fi
            '''

    rule fastqc:
        input:
            read = f"{data_dir}/{{sample}}.fastq.gz"
        output:
            html = f"{fastqc_dir}/{{sample}}_fastqc.html",
            zip  = f"{fastqc_dir}/{{sample}}_fastqc.zip"
        params:
            outdir = fastqc_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/fastqc-0.12.1
            fastqc {input.read} --outdir {params.outdir}
            '''

    rule multiqc:
        input:
            expand(f"{fastqc_dir}/{{sample}}_fastqc.zip", sample=SAMPLES)
        output:
            f"{fastqc_dir}/multiqc_report.html"
        params:
            outdir = fastqc_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/multiqc-1.23
            multiqc {params.outdir} -o {params.outdir}
            '''

# ── genome index (layout-independent) ───────────────────────────────────────

if ALIGNER == "hisat2":
    rule build_index:
        input:
            fasta = genome_dir
        output:
            INDEX_FILES
        params:
            prefix = ht2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/hisat2-2.1.0
            THREADS=${{NSLOTS:-$(nproc)}}
            hisat2-build -p $THREADS {input.fasta} {params.prefix}
            '''

elif ALIGNER == "bowtie2":
    rule build_index:
        input:
            fasta = genome_dir
        output:
            INDEX_FILES
        params:
            module = config["modules"]["bowtie2"],
            prefix = bt2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            THREADS=${{NSLOTS:-$(nproc)}}
            bowtie2-build --threads $THREADS {input.fasta} {params.prefix}
            '''

elif ALIGNER == "bwa":
    rule build_index:
        input:
            fasta = genome_dir
        output:
            INDEX_FILES
        params:
            module = config["modules"]["bwa"]
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            bwa index {input.fasta}
            '''

# ── alignment ────────────────────────────────────────────────────────────────

if ALIGNER == "hisat2" and LAYOUT == "paired":
    rule align:
        input:
            read_1 = f"{synced_dir}/{{sample}}_1.fastq.gz",
            read_2 = f"{synced_dir}/{{sample}}_2.fastq.gz",
            idx    = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt",
            novel   = f"{mapped_dir}/{{sample}}_novel_splicesites.txt"
        params:
            prefix = ht2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/hisat2-2.1.0
            THREADS=${{NSLOTS:-$(nproc)}}
            hisat2 -p $THREADS -x {params.prefix} \
                   -1 {input.read_1} -2 {input.read_2} \
                   --rna-strandness RF --dta \
                   --novel-splicesite-outfile {output.novel} \
                   --summary-file {output.summary} \
                   -S {output.sam}
            '''

elif ALIGNER == "hisat2" and LAYOUT == "single":
    rule align:
        input:
            read = f"{data_dir}/{{sample}}.fastq.gz",
            idx  = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt",
            novel   = f"{mapped_dir}/{{sample}}_novel_splicesites.txt"
        params:
            prefix = ht2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load programs/hisat2-2.1.0
            THREADS=${{NSLOTS:-$(nproc)}}
            hisat2 -p $THREADS -x {params.prefix} \
                   -U {input.read} \
                   --rna-strandness R --dta \
                   --novel-splicesite-outfile {output.novel} \
                   --summary-file {output.summary} \
                   -S {output.sam}
            '''

elif ALIGNER == "bowtie2" and LAYOUT == "paired":
    rule align:
        input:
            read_1 = f"{synced_dir}/{{sample}}_1.fastq.gz",
            read_2 = f"{synced_dir}/{{sample}}_2.fastq.gz",
            idx    = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt"
        params:
            module = config["modules"]["bowtie2"],
            prefix = bt2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            THREADS=${{NSLOTS:-$(nproc)}}
            bowtie2 -p $THREADS -x {params.prefix} \
                    -1 {input.read_1} -2 {input.read_2} \
                    2> {output.summary} \
                    -S {output.sam}
            '''

elif ALIGNER == "bowtie2" and LAYOUT == "single":
    rule align:
        input:
            read = f"{data_dir}/{{sample}}.fastq.gz",
            idx  = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt"
        params:
            module = config["modules"]["bowtie2"],
            prefix = bt2_index_prefix
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            THREADS=${{NSLOTS:-$(nproc)}}
            bowtie2 -p $THREADS -x {params.prefix} \
                    -U {input.read} \
                    2> {output.summary} \
                    -S {output.sam}
            '''

elif ALIGNER == "bwa" and LAYOUT == "paired":
    rule align:
        input:
            read_1 = f"{synced_dir}/{{sample}}_1.fastq.gz",
            read_2 = f"{synced_dir}/{{sample}}_2.fastq.gz",
            idx    = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt"
        params:
            module = config["modules"]["bwa"],
            genome = genome_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            THREADS=${{NSLOTS:-$(nproc)}}
            bwa mem -t $THREADS {params.genome} \
                    {input.read_1} {input.read_2} \
                    > {output.sam} \
                    2> {output.summary}
            '''

elif ALIGNER == "bwa" and LAYOUT == "single":
    rule align:
        input:
            read = f"{data_dir}/{{sample}}.fastq.gz",
            idx  = INDEX_FILES
        output:
            sam     = temp(f"{mapped_dir}/{{sample}}.sam"),
            summary = f"{stats_dir}/{{sample}}_alignment_summary.txt"
        params:
            module = config["modules"]["bwa"],
            genome = genome_dir
        shell:
            '''
            set +u
            source ~/.bashrc
            command -v module &>/dev/null && module load {params.module}
            THREADS=${{NSLOTS:-$(nproc)}}
            bwa mem -t $THREADS {params.genome} \
                    {input.read} \
                    > {output.sam} \
                    2> {output.summary}
            '''

# ── post-alignment (layout-independent) ─────────────────────────────────────

# sam to bam
rule sam_to_bam:
    input:
        f"{mapped_dir}/{{sample}}.sam"
    output:
        temp(f"{mapped_dir}/{{sample}}.bam")
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load programs/samtools-1.10
        THREADS=${{NSLOTS:-$(nproc)}}
        samtools view -Sb -@ $THREADS {input} > {output}
        '''

# bam sorting
rule sort_bam:
    input:
        f"{mapped_dir}/{{sample}}.bam"
    output:
        bam = f"{mapped_dir}/{{sample}}.sorted.bam"
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load programs/samtools-1.10
        THREADS=${{NSLOTS:-$(nproc)}}
        samtools sort -@ $THREADS {input} -o {output.bam}
        '''

# stats
rule flagstat:
    input:
        f"{mapped_dir}/{{sample}}.sorted.bam"
    output:
        f"{stats_dir}/{{sample}}.flagstat"
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load programs/samtools-1.10
        THREADS=${{NSLOTS:-$(nproc)}}
        samtools flagstat -@ $THREADS {input} > {output}
        '''

# coverage
# NOTE: this counts reads per *reference sequence*. config.yaml points `genome`
# at the RefSeq *_rna.fna transcript FASTA, so one reference == one transcript and
# column 4 (numreads) is a transcript-level count -- which is what lncker expects.
# Pointing `genome` at a genomic FASTA would silently yield per-scaffold counts.
rule coverage:
    input:
        f"{mapped_dir}/{{sample}}.sorted.bam"
    output:
        cov = f"{coverage_dir}/{{sample}}.coverage"
    log:
        f"{stats_dir}/{{sample}}.coverage.log"
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load programs/samtools-1.10
        samtools coverage {input} 2> {log} | awk '{{print $1"\t"$4}}' > {output}
        '''

# count table — merges all per-sample coverage files into genes × samples matrix
rule merge_counts:
    input:
        coverage = expand(f"{coverage_dir}/{{sample}}.coverage", sample=SAMPLES),
        script   = f"{scripts_dir}/merge_counts.py"
    output:
        f"{counts_dir}/count_table.txt"
    log:
        f"{stats_dir}/merge_counts.log"
    params:
        module     = config["modules"]["python"],
        python_bin = python_bin
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load {params.module}
        {params.python_bin} {input.script} {output} {input.coverage} &> {log}
        '''

# DESeq2 — runs all pairwise comparisons, writes one *_intersect.txt per pair
# The *_intersect.txt files are lncker's input, so they are declared explicitly
# rather than hidden inside a directory() output: that keeps them in the DAG and
# lets Snakemake tell a complete run from a partial one.
rule deseq2:
    input:
        counts   = f"{counts_dir}/count_table.txt",
        metadata = metadata_file,
        script   = f"{scripts_dir}/deseq2.py"
    output:
        intersects = expand(f"{deseq2_dir}/{{pair}}_intersect.txt", pair=PAIRS),
        results    = expand(f"{deseq2_dir}/{{pair}}_results.txt", pair=PAIRS),
        normalized = expand(f"{deseq2_dir}/{{pair}}_normalized_counts.txt", pair=PAIRS),
        ma_plots   = expand(f"{deseq2_dir}/{{pair}}_MA_plot.pdf", pair=PAIRS),
        pca        = f"{deseq2_dir}/PCA_plot.pdf"
    log:
        f"{stats_dir}/deseq2.log"
    params:
        module     = config["modules"]["python"],
        python_bin = python_bin,
        outdir     = deseq2_dir,
        padj       = config["deseq2"]["padj"],
        log2fc     = config["deseq2"]["log2fc"],
        min_counts = config["deseq2"]["min_counts"]
    shell:
        '''
        set +u
        source ~/.bashrc
        command -v module &>/dev/null && module load {params.module}
        mkdir -p {params.outdir}
        {params.python_bin} {input.script} \
            {input.counts} {input.metadata} {params.outdir} \
            {params.padj} {params.log2fc} {params.min_counts} &> {log}
        '''

# cleaning -- only ever run explicitly: `snakemake clean`
localrules: clean

rule clean:
    shell:
        '''
        rm -rfv {fastqc_dir}
        rm -rfv {mapped_dir}
        rm -rfv {stats_dir}
        rm -rfv {coverage_dir}
        rm -rfv {counts_dir}
        rm -rfv {deseq2_dir}
        '''
